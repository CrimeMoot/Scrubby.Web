<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <UserSecretsId>0928caad-0ee4-4f6b-b390-7f068139e559</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DMISharp" Version="2.1.0" />
        <PackageReference Include="LigerShark.WebOptimizer.Core" Version="3.0.477" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="9.0.9" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="9.0.9" />
        <PackageReference Include="MinVer" Version="6.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <!-- NU1902/NU1903: known ImageSharp advisories are patched in 4.1.2, which is incompatible with
             DMISharp 2.1.0; they require adversarial 32-bit float TIFF subjects via HistogramEqualization,
             which this app never processes (it only decodes DMI PNGs). -->
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" NoWarn="NU1902;NU1903" />
    </ItemGroup>

    <ItemGroup>
        <None Update="wwwroot\robots.txt">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
